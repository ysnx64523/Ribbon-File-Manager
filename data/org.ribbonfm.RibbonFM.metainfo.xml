<component type="desktop-application">
  <id>org.ribbonfm.RibbonFM</id>
  <metadata_license>CC0-1.0</metadata_license>
  <name>Ribbon File Manager</name>
  <name xml:lang="zh_CN">Ribbon 文件管理器</name>
  <summary>A cross-platform Ribbon-style file manager</summary>
  <summary xml:lang="zh_CN">跨平台 Ribbon 风格文件管理器</summary>
  <description>
    <p>
      RibbonFM is a file manager with a Windows-Explorer-like Ribbon toolbar.
      It is written in Python with GTK3 (PyGObject) and runs on Linux, Windows
      and macOS. It supports navigation, file operations, privilege escalation,
      multiple views and localisation.
    </p>
  </description>
